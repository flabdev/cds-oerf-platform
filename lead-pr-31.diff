+        page_two = kwargs.get("ExclusiveStartKey") is not None
+        if page_two:
+            self.continuations += 1
+            stamp = "2026-10-20T10:17:00Z"
+            if prefix == "READ#":
+                reading = {"sk": f"READ#{stamp}#000000000008", "ts": stamp, "temperature_c": 8.4}
+                return {"Items": [reading]}
+            if prefix == "EVT#":
