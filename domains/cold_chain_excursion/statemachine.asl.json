{
  "Comment": "cold_chain_excursion_v1 orchestration skeleton; integrate real business services incrementally. TimeoutSeconds is a tunable guard against orphaned executions.",
  "StartAt": "OPEN",
  "TimeoutSeconds": 86400,
  "States": {
    "OPEN": {"Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": {"FunctionName": "__STUB_ARN__", "Payload": {"step_name": "OPEN", "workflow.$": "$"}}, "OutputPath": "$.Payload", "TimeoutSeconds": 60, "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}], "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure"}], "Next": "GatherContext"},
    "GatherContext": {"Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": {"FunctionName": "__STUB_ARN__", "Payload": {"step_name": "GatherContext", "workflow.$": "$"}}, "OutputPath": "$.Payload", "TimeoutSeconds": 60, "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}], "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure"}], "Next": "Diagnose"},
    "Diagnose": {"Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": {"FunctionName": "__STUB_ARN__", "Payload": {"step_name": "Diagnose", "workflow.$": "$"}}, "OutputPath": "$.Payload", "TimeoutSeconds": 60, "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}], "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure"}], "Next": "Assess"},
    "Assess": {"Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": {"FunctionName": "__STUB_ARN__", "Payload": {"step_name": "Assess", "workflow.$": "$"}}, "OutputPath": "$.Payload", "TimeoutSeconds": 60, "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}], "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure"}], "Next": "NeedApproval?"},
    "NeedApproval?": {"Type": "Choice", "Choices": [{"Variable": "$.decision.needs_approval", "BooleanEquals": true, "Next": "Approval"}], "Default": "SecureFacility"},
    "Approval": {"Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": {"FunctionName": "__STUB_ARN__", "Payload": {"step_name": "Approval", "workflow.$": "$"}}, "OutputPath": "$.Payload", "TimeoutSeconds": 60, "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}], "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure"}], "Next": "ApprovalDecision"},
    "ApprovalDecision": {"Type": "Choice", "Choices": [{"Variable": "$.approval.status", "StringEquals": "approved", "Next": "SecureFacility"}, {"Variable": "$.approval.status", "StringEquals": "auto_proceed", "Next": "SecureFacility"}], "Default": "Escalate"},
    "SecureFacility": {"Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": {"FunctionName": "__STUB_ARN__", "Payload": {"step_name": "SecureFacility", "workflow.$": "$"}}, "OutputPath": "$.Payload", "TimeoutSeconds": 60, "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}], "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure"}], "Next": "FacilityAccepted?"},
    "FacilityAccepted?": {"Type": "Choice", "Choices": [{"Variable": "$.facility.accepted", "BooleanEquals": true, "Next": "Act"}], "Default": "Escalate"},
    "Act": {"Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": {"FunctionName": "__STUB_ARN__", "Payload": {"step_name": "Act", "workflow.$": "$"}}, "OutputPath": "$.Payload", "TimeoutSeconds": 60, "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}], "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure"}], "Next": "VerifyLoop"},
    "VerifyLoop": {"Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": {"FunctionName": "__STUB_ARN__", "Payload": {"step_name": "Verify", "workflow.$": "$"}}, "OutputPath": "$.Payload", "TimeoutSeconds": 60, "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}], "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure"}], "Next": "ContainmentDecision"},
    "ContainmentDecision": {"Type": "Choice", "Choices": [{"Variable": "$.containment.status", "StringEquals": "contained", "Next": "GenerateReport"}, {"Variable": "$.containment.status", "StringEquals": "reopened", "Next": "HandleReopen"}], "Default": "WaitBeforeVerify"},
    "WaitBeforeVerify": {"Type": "Wait", "Seconds": 60, "Next": "VerifyLoop"},
    "HandleReopen": {"Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": {"FunctionName": "__STUB_ARN__", "Payload": {"step_name": "HandleReopen", "workflow.$": "$"}}, "OutputPath": "$.Payload", "TimeoutSeconds": 60, "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}], "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure"}], "Next": "VerifyLoop"},
    "GenerateReport": {"Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": {"FunctionName": "__STUB_ARN__", "Payload": {"step_name": "GenerateReport", "workflow.$": "$"}}, "OutputPath": "$.Payload", "TimeoutSeconds": 60, "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}], "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure"}], "Next": "QA"},
    "QA": {"Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": {"FunctionName": "__STUB_ARN__", "Payload": {"step_name": "QA", "workflow.$": "$"}}, "OutputPath": "$.Payload", "TimeoutSeconds": 60, "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}], "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure"}], "Next": "QADecision"},
    "QADecision": {"Type": "Choice", "Choices": [{"Variable": "$.qa.disposition", "StringEquals": "approved", "Next": "Close"}], "Default": "Escalate"},
    "Close": {"Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": {"FunctionName": "__STUB_ARN__", "Payload": {"step_name": "Close", "workflow.$": "$"}}, "OutputPath": "$.Payload", "TimeoutSeconds": 60, "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}], "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.failure", "Next": "RecordFailure"}], "Next": "WorkflowComplete"},
    "RecordFailure": {"Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": {"FunctionName": "__STUB_ARN__", "Payload": {"step_name": "RecordFailure", "workflow.$": "$"}}, "OutputPath": "$.Payload", "TimeoutSeconds": 60, "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}], "Catch": [{"ErrorEquals": ["States.ALL"], "ResultPath": "$.record_failure_error", "Next": "Escalate"}], "Next": "Escalate"},
    "Escalate": {"Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": {"FunctionName": "__STUB_ARN__", "Payload": {"step_name": "Escalate", "workflow.$": "$"}}, "OutputPath": "$.Payload", "TimeoutSeconds": 60, "Retry": [{"ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2}], "End": true},
    "WorkflowComplete": {"Type": "Succeed"}
  }
}
