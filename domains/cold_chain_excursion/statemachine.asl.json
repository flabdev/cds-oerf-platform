{
  "Comment": "cold_chain_excursion_v1 workflow. Human approval uses a task token; cancellation and all failure branches are bounded and routed through canonical incident transitions.",
  "StartAt": "OPEN",
  "TimeoutSeconds": 86400,
  "States": {
    "OPEN": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STUB_ARN__",
        "Payload": {
          "step_name": "OPEN",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "CancelAfterOPEN?"
    },
    "GatherContext": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STEP_CONTEXT_ARN__",
        "Payload": {
          "step_name": "GatherContext",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "CancelAfterGatherContext?"
    },
    "Diagnose": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STEP_DIAGNOSE_ARN__",
        "Payload": {
          "step_name": "Diagnose",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "CancelAfterDiagnose?"
    },
    "Assess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STEP_ASSESS_ARN__",
        "Payload": {
          "step_name": "Assess",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "CancelAfterAssess?"
    },
    "EngageDriverDiagnosis": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "__ENGAGE_PARTY_ARN__",
        "Input": {
          "tenant_id.$": "$.tenant_id",
          "incident_id.$": "$.incident_id",
          "engagement_id.$": "$.workflow.diagnosis.engagement_id",
          "role": "driver",
          "ask": "diagnose",
          "policy_id.$": "$.workflow.diagnosis.policy_id",
          "facts.$": "$.context"
        }
      },
      "ResultPath": "$.workflow.diagnosis.engagement_result",
      "TimeoutSeconds": 86400,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "CancelAfterEngageDriverDiagnosis?"
    },
    "NeedApproval?": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.decision.has_feasible_options",
              "IsPresent": true
            },
            {
              "Variable": "$.decision.has_feasible_options",
              "BooleanEquals": false
            }
          ],
          "Next": "Escalate"
        },
        {
          "And": [
            {
              "Variable": "$.decision.needs_approval",
              "IsPresent": true
            },
            {
              "Variable": "$.decision.needs_approval",
              "BooleanEquals": true
            }
          ],
          "Next": "Approval"
        }
      ],
      "Default": "SecureFacility"
    },
    "Approval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "__STUB_ARN__",
        "Payload": {
          "step_name": "Approval",
          "workflow.$": "$",
          "task_token.$": "$$.Task.Token"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 1800,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.Timeout"
          ],
          "ResultPath": "$.approval_timeout",
          "Next": "NoResponse"
        },
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "CancelAfterApproval?"
    },
    "ApprovalDecision": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.approval.status",
              "IsPresent": true
            },
            {
              "Variable": "$.approval.status",
              "StringEquals": "approved"
            }
          ],
          "Next": "SecureFacility"
        },
        {
          "And": [
            {
              "Variable": "$.approval.status",
              "IsPresent": true
            },
            {
              "Variable": "$.approval.status",
              "StringEquals": "auto_proceed"
            }
          ],
          "Next": "SecureFacility"
        },
        {
          "And": [
            {
              "Variable": "$.approval.status",
              "IsPresent": true
            },
            {
              "Variable": "$.approval.status",
              "StringEquals": "cancelled"
            }
          ],
          "Next": "Cancel"
        }
      ],
      "Default": "Escalate"
    },
    "SecureFacility": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STUB_ARN__",
        "Payload": {
          "step_name": "SecureFacility",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "CancelAfterSecureFacility?"
    },
    "FacilityAccepted?": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.facility.accepted",
              "IsPresent": true
            },
            {
              "Variable": "$.facility.accepted",
              "BooleanEquals": true
            }
          ],
          "Next": "Act"
        }
      ],
      "Default": "Escalate"
    },
    "Act": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STEP_ACT_ARN__",
        "Payload": {
          "step_name": "Act",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "CancelAfterAct?"
    },
    "DecisionKind?": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {"Variable": "$.workflow.action.kind", "IsPresent": true},
            {"Variable": "$.workflow.action.kind", "StringEquals": "continue"}
          ],
          "Next": "NotifyContinue"
        },
        {
          "And": [
            {"Variable": "$.workflow.action.kind", "IsPresent": true},
            {"Variable": "$.workflow.action.kind", "StringEquals": "facility"}
          ],
          "Next": "NotifyDivert"
        }
      ],
      "Default": "VerifyLoop"
    },
    "NotifyContinue": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__CHANNEL_ROUTER_ARN__",
        "Payload": {
          "step_name": "EngagementSendOneWay",
          "tenant_id.$": "$.tenant_id",
          "incident_id.$": "$.incident_id",
          "role": "driver",
          "message": "status_update",
          "channel": "whatsapp",
          "facts": {
            "shipment_id.$": "$.shipment_id",
            "shipment.$": "$.workflow.context.shipment",
            "action.$": "$.workflow.action"
          },
          "dedupe_key.$": "States.Format('{}:decision', $.incident_id)"
        }
      },
      "ResultPath": "$.driver_notice",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.driver_notice_error",
          "Next": "CancelAfterNotifyContinue?"
        }
      ],
      "Next": "CancelAfterNotifyContinue?"
    },
    "NotifyDivert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__CHANNEL_ROUTER_ARN__",
        "Payload": {
          "step_name": "EngagementSendOneWay",
          "tenant_id.$": "$.tenant_id",
          "incident_id.$": "$.incident_id",
          "role": "driver",
          "message": "driver_reroute",
          "channel": "whatsapp",
          "facts": {
            "shipment_id.$": "$.shipment_id",
            "shipment.$": "$.workflow.context.shipment",
            "action.$": "$.workflow.action",
            "facilities.$": "$.workflow.context.facilities"
          },
          "dedupe_key.$": "States.Format('{}:decision', $.incident_id)"
        }
      },
      "ResultPath": "$.driver_notice",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.driver_notice_error",
          "Next": "CancelAfterNotifyDivert?"
        }
      ],
      "Next": "CancelAfterNotifyDivert?"
    },
    "VerifyLoop": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STEP_VERIFY_ARN__",
        "Payload": {
          "step_name": "Verify",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "CancelAfterVerifyLoop?"
    },
    "ContainmentDecision": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.containment.status",
              "IsPresent": true
            },
            {
              "Variable": "$.containment.status",
              "StringEquals": "contained"
            }
          ],
          "Next": "RecordContainment"
        },
        {
          "And": [
            {
              "Variable": "$.containment.status",
              "IsPresent": true
            },
            {
              "Variable": "$.containment.status",
              "StringEquals": "reopened"
            }
          ],
          "Next": "HandleReopen"
        }
      ],
      "Default": "WaitBeforeVerify"
    },
    "WaitBeforeVerify": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "VerifyLoop"
    },
    "HandleReopen": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STUB_ARN__",
        "Payload": {
          "step_name": "HandleReopen",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "CancelAfterHandleReopen?"
    },
    "GenerateReport": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STUB_ARN__",
        "Payload": {
          "step_name": "GenerateReport",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "CancelAfterGenerateReport?"
    },
    "QA": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STEP_QA_ARN__",
        "Payload": {
          "step_name": "QA",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "CancelAfterQA?"
    },
    "QADecision": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.qa.disposition",
              "IsPresent": true
            },
            {
              "Variable": "$.qa.disposition",
              "StringEquals": "approved"
            }
          ],
          "Next": "Close"
        },
        {
          "And": [
            {
              "Variable": "$.qa.disposition",
              "IsPresent": true
            },
            {
              "Variable": "$.qa.disposition",
              "StringEquals": "rejected"
            }
          ],
          "Next": "HandleReopen"
        }
      ],
      "Default": "FailureRoute"
    },
    "Close": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STEP_CLOSE_ARN__",
        "Payload": {
          "step_name": "Close",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "TerminalFailure"
        }
      ],
      "Next": "WorkflowComplete"
    },
    "RecordFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STEP_RECORD_FAILURE_ARN__",
        "Payload": {
          "step_name": "RecordFailure",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.record_failure_error",
          "Next": "FailureRoute"
        }
      ],
      "Next": "FailureRoute"
    },
    "Escalate": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STEP_ESCALATE_ARN__",
        "Payload": {
          "step_name": "Escalate",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "End": true
    },
    "WorkflowComplete": {
      "Type": "Succeed"
    },
    "NoResponse": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STUB_ARN__",
        "Payload": {
          "step_name": "NoResponse",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure",
          "Next": "RecordFailure"
        }
      ],
      "Next": "RecordFailure"
    },
    "FailureRoute": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.incident_state",
              "IsPresent": true
            },
            {
              "Variable": "$.incident_state",
              "StringEquals": "ASSESSING"
            }
          ],
          "Next": "Escalate"
        },
        {
          "And": [
            {
              "Variable": "$.incident_state",
              "IsPresent": true
            },
            {
              "Variable": "$.incident_state",
              "StringEquals": "AWAITING_APPROVAL"
            }
          ],
          "Next": "Escalate"
        },
        {
          "And": [
            {
              "Variable": "$.incident_state",
              "IsPresent": true
            },
            {
              "Variable": "$.incident_state",
              "StringEquals": "SECURING_FACILITY"
            }
          ],
          "Next": "Escalate"
        },
        {
          "And": [
            {
              "Variable": "$.incident_state",
              "IsPresent": true
            },
            {
              "Variable": "$.incident_state",
              "StringEquals": "IN_TRANSIT"
            }
          ],
          "Next": "Escalate"
        }
      ],
      "Default": "Cancel"
    },
    "CancelRequested?": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.cancel_requested",
              "IsPresent": true
            },
            {
              "Variable": "$.cancel_requested",
              "BooleanEquals": true
            }
          ],
          "Next": "Cancel"
        }
      ],
      "Default": "GatherContext"
    },
    "Cancel": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STEP_CANCEL_ARN__",
        "Payload": {
          "step_name": "Cancel",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "End": true
    },
    "RecordContainment": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "__STUB_ARN__",
        "Payload": {
          "step_name": "RecordContainment",
          "workflow.$": "$"
        }
      },
      "OutputPath": "$.Payload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
