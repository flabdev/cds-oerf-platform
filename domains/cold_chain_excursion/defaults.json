{
  "domain": "cold_chain_excursion",
  "version": 1,
  "status": "published",
  "trigger": {
    "metric": "temperature_c",
    "condition": "above_upper",
    "debounce_readings": 2
  },
  "product_profiles": [
    {
      "id": "PP-2-8-45",
      "name": "Biologic 2-8",
      "range_c": [2, 8],
      "excursion_allowance_min": 45,
      "allowance_mode": "cumulative"
    }
  ],
  "assessment": {
    "search_radius_km": 30,
    "max_candidates": 3,
    "unload_min": 4,
    "rise_rate_c_per_min": 0.03,
