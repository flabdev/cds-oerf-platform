{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["policies"],
  "properties": {
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_id",
          "urgency",
          "respect_quiet_hours",
          "exhaust_after",
          "exhaust_action",
          "rungs"
        ],
        "properties": {
          "policy_id": { "type": "string", "minLength": 1 },
          "urgency": { "enum": ["critical", "normal"] },
          "respect_quiet_hours": { "type": "boolean" },
          "exhaust_after": { "type": "string", "minLength": 1 },
          "exhaust_action": { "type": "object" },
          "final_question": { "type": ["string", "null"] },
          "rungs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["after", "anchor", "action", "channel", "message"],
              "properties": {
                "after": { "type": "string", "minLength": 1 },
                "anchor": { "enum": ["engagement_start", "previous_rung"] },
                "action": { "enum": ["send", "call", "escalate"] },
                "channel": { "enum": ["whatsapp", "sms", "voice", "email"] },
                "message": { "type": "string", "minLength": 1 },
                "to_role": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
