{
  "type": "AWS::Logs::Delivery",
  "handlers": {
    "create": [
      "logs:CreateDelivery",
      "logs:GetDelivery",
      "logs:DescribeDeliveries",
      "logs:ListTagsForResource",
      "logs:TagResource",
      "logs:GetDeliverySource",
      "logs:GetDeliveryDestination"
    ],
    "read": [
      "logs:GetDelivery",
      "logs:ListTagsForResource"
    ],
    "update": [
      "logs:GetDelivery",
      "logs:ListTagsForResource",
      "logs:TagResource",
      "logs:UntagResource",
      "logs:UpdateDeliveryConfiguration"
    ],
    "delete": [
      "logs:DeleteDelivery",
      "logs:ListTagsForResource",
      "logs:UntagResource"
    ],
    "list": [
      "logs:DescribeDeliveries",
      "logs:ListTagsForResource"
    ]
  }
}
