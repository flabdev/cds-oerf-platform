{
  "type": "AWS::SNS::Subscription",
  "handlers": {
    "create": [
      "iam:GetRole",
      "iam:PassRole",
      "sns:Subscribe"
    ],
    "read": [
      "sns:GetSubscriptionAttributes"
    ],
    "update": [
      "iam:GetRole",
      "iam:PassRole",
      "sns:SetSubscriptionAttributes"
    ],
    "delete": [
      "sns:Unsubscribe",
      "sns:GetSubscriptionAttributes"
    ],
    "list": [
      "sns:ListSubscriptions"
    ]
  }
}
